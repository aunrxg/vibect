{
  "name": "api",
  "version": "1.0.0",
  "description": "Fastify API server for Vibect",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "Backend",
    "API",
    "Fastify",
    "Vibect"
  ],
  "author": "aunrxg",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vibect/typescript-config": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@supabase/supabase-js": "^2.78.0",
    "@vibect/db": "workspace:*",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.1.12"
  }
}
