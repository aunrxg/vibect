generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DIRECT_URL")
}

model User {
  id          String        @id @default(uuid()) @db.Uuid
  email       String        @unique
  name        String?
  avatarUrl   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  songs       Songs[]
  memberships SpaceMember[]
  spaces      Space[]
  votes       Votes[]

  @@map("users")
}

model Space {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isPublic    Boolean       @default(true)
  inviteCode  String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ownerId     String        @db.Uuid
  songs       Songs[]
  memberships SpaceMember[]
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([inviteCode])
  @@map("spaces")
}

model SpaceMember {
  id       String     @id @default(uuid()) @db.Uuid
  userId   String     @db.Uuid
  spaceId  String     @db.Uuid
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  space    Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@index([userId])
  @@map("space_members")
}

model Songs {
  id               String          @id @default(uuid()) @db.Uuid
  youtubeId        String
  title            String
  artist           String?
  thumbnailUrl     String?
  duration         Int
  addedAt          DateTime        @default(now()) @map("added_at")
  playedAt         DateTime?       @map("played_at")
  spaceId          String          @map("space_id") @db.Uuid
  addedById        String?         @map("added_by_id") @db.Uuid
  addedByAnonymous String?         @map("added_by_anonymous")
  anonymousVotes   anonymousVote[]
  addedBy          User?           @relation(fields: [addedById], references: [id])
  space            Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  votes            Votes[]

  // REMOVING the old unique contraint: Postgres has special rule about NULLABLE in unique contraints
  // @@unique([spaceId, youtubeId, playedAt], name: "unique_song_in_queue")
  @@index([spaceId, playedAt])
  @@index([addedById])
  @@index([youtubeId])
  @@map("songs")
}

model Votes {
  id        String   @id @default(uuid()) @db.Uuid
  value     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  songId    String   @map("song_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  song      Songs    @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([songId, userId])
  @@index([songId])
  @@index([userId])
  @@map("votes")
}

model anonymousVote {
  id          String   @id @default(uuid()) @db.Uuid
  anonymousId String   @map("anonymous_id")
  value       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  songId      String   @map("song_id") @db.Uuid
  song        Songs    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, anonymousId])
  @@index([songId])
  @@index([anonymousId])
  @@map("anonymous_votes")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}
